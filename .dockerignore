# Start with an empty build context and include only runtime/build inputs.
# In particular: no repository history, credentials, uploads or local results.
**
!Dockerfile
!money_graph/
money_graph/*
!money_graph/requirements.txt
!money_graph/requirements-ai.txt
!money_graph/config.json
!money_graph/serve.py
!money_graph/run.py
!money_graph/check.py
!money_graph/api/
!money_graph/api/**
!money_graph/mg/
!money_graph/mg/**
!money_graph/ui/
!money_graph/ui/**
!money_graph/vendor/
!money_graph/vendor/**
!money_graph/data/
money_graph/data/*
!money_graph/data/nodes.parquet
!money_graph/data/edges.parquet
!money_graph/data/transactions.parquet
!money_graph/web/
money_graph/web/*
!money_graph/web/package.json
!money_graph/web/package-lock.json
!money_graph/web/index.html
!money_graph/web/tsconfig.json
!money_graph/web/vite.config.ts
!money_graph/web/postcss.config.js
!money_graph/web/tailwind.config.js
!money_graph/web/public/
!money_graph/web/public/**
!money_graph/web/src/
!money_graph/web/src/**

# Keep sensitive/generated files excluded even inside an allowed source tree.
**/.git
**/.git/**
**/.env
**/.env.*
**/*.key
**/*.pem
**/.local
**/.local/**
**/projects
**/projects/**
**/node_modules
**/node_modules/**
**/__pycache__
**/__pycache__/**
**/*.pyc
**/*.pyo
**/*.tsbuildinfo
